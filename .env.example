# --- Docker Compose runtime ---
POSTGRES_DB=kiotviet_taphoa
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# --- App / integration variables from PRD ---
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/kiotviet_taphoa
DB_APP_URL=postgresql://app_user:change_me@localhost:5432/kiotviet_taphoa
DB_ADMIN_URL=postgresql://admin_reader:change_me@localhost:5432/kiotviet_taphoa
DB_STATEMENT_TIMEOUT_MS=5000
ZALO_APP_ID=YOUR_ZALO_APP_ID
ZALO_OA_SECRET=YOUR_ZALO_OA_SECRET
ZALO_OA_ACCESS_TOKEN=BOOTSTRAP_ONLY_REFRESH_LATER
KIOTVIET_CLIENT_ID=YOUR_KIOTVIET_CLIENT_ID
KIOTVIET_CLIENT_SECRET=YOUR_KIOTVIET_CLIENT_SECRET
KIOTVIET_RETAILER=YOUR_RETAILER_NAME
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LOG_LEVEL=info
READYZ_STRICT=true
READYZ_TIMEOUT_MS=300
REDIS_URL=redis://:change_me@localhost:6379/0
INVITE_PEPPER_B64=

OPS_ALERT_WEBHOOK_URL=https://example.com/hooks/ops-summary

# --- Security / validation / retention ---
WEBHOOK_REPLAY_WINDOW_SECONDS=300
ALLOWED_FILE_URL_HOSTS=
MIN_CUSTOM_PRICE=100
MAX_CUSTOM_PRICE=1000000000
INVOICE_PARSED_DATA_RETENTION_DAYS=180
OPS_EVENTS_RETENTION_DAYS=90

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# polling (VPS) | webhook
TELEGRAM_MODE=polling
# Webhook mode: value Telegram sends in X-Telegram-Bot-Api-Secret-Token (secret; set in your local .env only)
TELEGRAM_WEBHOOK_SECRET=
# Optional Bot API root for the worker (default https://api.telegram.org). The E2E gate points it at a stub.
TELEGRAM_API_BASE_URL=

# --- ShopVoice MCP server (apps/mcp-server) ---
MCP_HOST=0.0.0.0
MCP_PORT=8090
# Runtime DB URL (app role, RLS-bound). Falls back to DB_APP_URL / DATABASE_URL, then to the MCP_DB_* parts below.
MCP_DB_URL=postgresql://app_user:change_me@localhost:5432/kiotviet_taphoa
# Split DB settings (Render); used only when no URL is set. User and password are URL-encoded.
MCP_DB_HOST=
MCP_DB_PORT=5432
MCP_DB_NAME=
MCP_DB_USER=
# Secret: runtime role password (db_prepare creates the role with it).
MCP_DB_PASSWORD=
# Local development only: allow a superuser / BYPASSRLS DB user. Never set in production.
MCP_ALLOW_PRIVILEGED_DB_USER=false
# postgres | memory (memory = built-in demo dataset, no DB; needs MCP_DEMO_TOKEN)
MCP_DATA_BACKEND=postgres
# Comma-separated browser origins allowed to call /mcp (requests without Origin are allowed).
MCP_ALLOWED_ORIGINS=
# Allow http(s)://localhost:* origins (MCP Inspector). Defaults to true unless NODE_ENV=production.
MCP_ALLOW_LOCALHOST_ORIGINS=
# Trusted proxy hops in front of the server for per-IP limits: false/0, true/1, or N (Render: 2).
MCP_TRUST_PROXY=false
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_AUTH_FAILURES_PER_MINUTE=20
MCP_CONFIRM_TTL_SECONDS=300
MCP_SESSION_IDLE_SECONDS=1800
MCP_MAX_SESSIONS=500
MCP_MAX_BODY_BYTES=262144
MCP_TOKEN_CACHE_SECONDS=30
MCP_JSON_RESPONSES=true
# Secret: demo tenant bearer token (>= 32 chars). Used by `db:v2:seed -- --demo` and the memory backend.
MCP_DEMO_TOKEN=
# Secret: read-only (shop.read) judge token for MCP Inspector. Memory backend and scripts/deploy/*.
MCP_JUDGE_TOKEN=
# Hosted demo deploy scripts (scripts/deploy/db_prepare.mjs, reseed_demo.mjs): superuser connection.
PGHOST=
PGPORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=
# Secret: superuser password (only the DB, pre-deploy and reseed cron use it).
POSTGRES_PASSWORD=
# Shop time zone for the demo reseed's "today".
DEMO_SHOP_TIMEZONE=Asia/Ho_Chi_Minh
# Optional YYYY-MM-DD anchor for the demo seed ("today"); defaults to today in Asia/Ho_Chi_Minh.
DEMO_ANCHOR_DATE=

# --- ShopVoice OAuth 2.1 (Claude connector); all optional, OAuth is off when PUBLIC_BASE_URL is empty ---
# Public origin that serves /mcp, /.well-known/* and /oauth/* (https; http only for localhost outside production).
# The OAuth issuer is this origin and the token audience (resource) is PUBLIC_BASE_URL/mcp.
PUBLIC_BASE_URL=
# Secret: HMAC key for the sign-in session cookie (>= 32 random chars, e.g. `openssl rand -base64 48`). Required with PUBLIC_BASE_URL.
OAUTH_COOKIE_SECRET=
OAUTH_ACCESS_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_DAYS=30
# Dynamic client registrations per IP per hour (Anthropic egress 160.79.104.0/21 shares a 100x bucket).
OAUTH_DCR_PER_HOUR=30
# Sign-in / sign-up attempts per IP per minute (accounts also lock for 15 min after 5 failed logins).
OAUTH_LOGIN_PER_MINUTE=20
# Public support contact shown on /support, /privacy and the sign-in pages.
SUPPORT_EMAIL=
# INVITE_PEPPER_B64 (see above) also lets a web account link a real shop with an invite code.

# --- ShopVoice simulator (apps/alexa-sim) ---
SIM_HOST=0.0.0.0
SIM_PORT=8091
SIM_MCP_URL=http://127.0.0.1:8090/mcp
# Alternative to SIM_MCP_URL on Render's private network: host:port of the MCP service (-> http://host:port/mcp).
SIM_MCP_HOSTPORT=
# MCP endpoint shown on the page when the simulator reaches MCP privately (e.g. https://<mcp host>/mcp).
SIM_PUBLIC_MCP_URL=
# Secret: MCP bearer token the simulator uses (demo tenant). Defaults to MCP_DEMO_TOKEN.
SIM_MCP_TOKEN=
# claude | rules | bedrock. Empty: claude when ANTHROPIC_API_KEY is set, else rules (offline).
# bedrock is implemented, not deployed (AWS account unavailable): untested.
SIM_BRAIN=
# Secret: Anthropic API key for the Claude brain. Never commit it; set a spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=
# sonnet (Claude Sonnet 5.5, default) | haiku (Claude Haiku 4.5). Opus is refused (too slow for voice).
CLAUDE_MODEL=sonnet
# low (default) | medium | high; Sonnet only.
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=2048
# Cost guard: Claude turns and estimated USD per UTC day; past either, turns use the offline rules brain.
CLAUDE_DAILY_TURN_CAP=400
CLAUDE_DAILY_BUDGET_USD=1
# Claude's share of one turn (ms) before the rules brain answers instead.
SIM_TURN_DEADLINE_MS=11000
# Implemented, not deployed (AWS account unavailable): Bedrock brain and Polly voice.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# browser | polly
SIM_TTS=browser
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
AWS_REGION=us-east-1
# Secret: optional passcode for /api/* on a public deployment.
SIM_ACCESS_CODE=
# Turns per minute per viewer IP, and for all viewers together.
SIM_TURNS_PER_MINUTE=20
SIM_GLOBAL_TURNS_PER_MINUTE=60
# Trusted proxy hops in front of the simulator for per-IP limits (0 = none; Render = 2).
SIM_TRUST_PROXY=0
SIM_SHOP_TIMEZONE=Asia/Ho_Chi_Minh

# Secret shared with CloudFront (custom origin header X-Origin-Verify). When set, the MCP server and
# simulator reject requests without it (except /healthz), so the origin can't be reached around CloudFront.
ORIGIN_VERIFY_SECRET=
