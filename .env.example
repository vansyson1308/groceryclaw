# --- Docker Compose runtime ---
POSTGRES_DB=kiotviet_taphoa
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_BASE_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# --- App / integration variables from PRD ---
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/kiotviet_taphoa
DB_APP_URL=postgresql://app_user:change_me@localhost:5432/kiotviet_taphoa
DB_ADMIN_URL=postgresql://admin_reader:change_me@localhost:5432/kiotviet_taphoa
DB_STATEMENT_TIMEOUT_MS=5000
ZALO_APP_ID=YOUR_ZALO_APP_ID
ZALO_OA_SECRET=YOUR_ZALO_OA_SECRET
ZALO_OA_ACCESS_TOKEN=BOOTSTRAP_ONLY_REFRESH_LATER
KIOTVIET_CLIENT_ID=YOUR_KIOTVIET_CLIENT_ID
KIOTVIET_CLIENT_SECRET=YOUR_KIOTVIET_CLIENT_SECRET
KIOTVIET_RETAILER=YOUR_RETAILER_NAME
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LOG_LEVEL=info
READYZ_STRICT=true
READYZ_TIMEOUT_MS=300
REDIS_URL=redis://:change_me@localhost:6379/0
INVITE_PEPPER_B64=

OPS_ALERT_WEBHOOK_URL=https://example.com/hooks/ops-summary

# --- Security / validation / retention ---
WEBHOOK_REPLAY_WINDOW_SECONDS=300
ALLOWED_FILE_URL_HOSTS=
MIN_CUSTOM_PRICE=100
MAX_CUSTOM_PRICE=1000000000
INVOICE_PARSED_DATA_RETENTION_DAYS=180
OPS_EVENTS_RETENTION_DAYS=90

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# --- ShopVoice MCP server (apps/mcp-server) ---
MCP_HOST=0.0.0.0
MCP_PORT=8090
# Runtime DB URL (app role, RLS-bound). Falls back to DB_APP_URL / DATABASE_URL.
MCP_DB_URL=postgresql://app_user:change_me@localhost:5432/kiotviet_taphoa
# postgres | memory (memory = built-in demo dataset, no DB; needs MCP_DEMO_TOKEN)
MCP_DATA_BACKEND=postgres
# Comma-separated browser origins allowed to call /mcp (requests without Origin are allowed).
MCP_ALLOWED_ORIGINS=
# Allow http(s)://localhost:* origins (MCP Inspector). Defaults to true unless NODE_ENV=production.
MCP_ALLOW_LOCALHOST_ORIGINS=
# Trust X-Forwarded-For for per-IP limits (only behind a trusted proxy/load balancer).
MCP_TRUST_PROXY=false
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_AUTH_FAILURES_PER_MINUTE=20
MCP_CONFIRM_TTL_SECONDS=300
MCP_SESSION_IDLE_SECONDS=1800
MCP_MAX_SESSIONS=500
MCP_MAX_BODY_BYTES=262144
MCP_TOKEN_CACHE_SECONDS=30
MCP_JSON_RESPONSES=true
# Secret: demo tenant bearer token (>= 32 chars). Used by `db:v2:seed -- --demo` and the memory backend.
MCP_DEMO_TOKEN=
# Optional YYYY-MM-DD anchor for the demo seed ("today"); defaults to today in Asia/Ho_Chi_Minh.
DEMO_ANCHOR_DATE=

# --- ShopVoice simulator (apps/alexa-sim) ---
SIM_HOST=0.0.0.0
SIM_PORT=8091
SIM_MCP_URL=http://127.0.0.1:8090/mcp
# Secret: MCP bearer token the simulator uses (demo tenant). Defaults to MCP_DEMO_TOKEN.
SIM_MCP_TOKEN=
# rules | bedrock
SIM_BRAIN=rules
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# browser | polly
SIM_TTS=browser
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
AWS_REGION=us-east-1
# Secret: optional passcode for /api/* on a public deployment.
SIM_ACCESS_CODE=
SIM_TURNS_PER_MINUTE=30
SIM_SHOP_TIMEZONE=Asia/Ho_Chi_Minh
