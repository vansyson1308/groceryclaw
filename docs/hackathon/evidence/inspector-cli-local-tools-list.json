    {
      "name": "get_sales_summary",
      "title": "Sales summary",
      "description": "Revenue and units sold for a period (today, yesterday, this week, last week, last 7/30 days, or a custom date range), compared by default with the same weekday last week (single days) or the previous period. Use compare_weekday for \"compared to last Friday\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "default": "today",
            "type": "string",
            "enum": [
              "today",
              "yesterday",
              "this_week",
              "last_week",
              "last_7_days",
              "last_30_days",
              "custom"
            ]
          },
          "start_date": {
            "description": "Required when period is \"custom\".",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "description": "Custom period end (defaults to start_date).",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "compare_to": {
            "default": "auto",
            "type": "string",
            "enum": [
              "auto",
              "same_weekday_last_week",
              "previous_period",
              "none"
            ]
          },
          "compare_weekday": {
            "description": "Compare with the most recent such weekday before the period, e.g. \"friday\" for \"vs last Friday\".",
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "partial": {
                "type": "boolean"
              }
            },
            "required": [
              "start",
              "end",
              "label",
              "partial"
            ],
            "additionalProperties": false
          },
          "currency": {
            "type": "string"
          },
          "revenue_vnd": {
            "type": "number"
          },
          "revenue": {
            "type": "number"
          },
          "units": {
            "type": "number"
          },
          "comparison": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "period": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string"
                      },
                      "end": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "partial": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "start",
                      "end",
                      "label",
                      "partial"
                    ],
                    "additionalProperties": false
                  },
                  "revenue_vnd": {
                    "type": "number"
                  },
                  "revenue": {
                    "type": "number"
                  },
                  "units": {
                    "type": "number"
                  },
                  "change_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percent_of_comparison": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "period",
                  "revenue_vnd",
                  "revenue",
                  "units",
                  "change_pct",
                  "percent_of_comparison"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "period",
          "currency",
          "revenue_vnd",
          "revenue",
          "units",
          "comparison"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "title": "Sales summary",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
