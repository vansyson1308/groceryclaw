{
  "name": "shopvoice-infra-aws",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app for the ShopVoice (Alexa+ MCP) hackathon deployment: EC2 + docker compose + CloudFront + SSM.",
  "scripts": {
    "build": "tsc",
    "synth": "tsc && cdk synth",
    "deploy": "tsc && cdk deploy --require-approval never",
    "destroy": "cdk destroy --force"
  },
  "dependencies": {
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "aws-cdk": "2.1143.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
