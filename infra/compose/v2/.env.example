# V2 local compose environment template (development only)
# Copy to infra/compose/v2/.env and fill required values locally (do not commit).

NODE_ENV=development
LOG_LEVEL=info
READYZ_STRICT=true
READYZ_TIMEOUT_MS=300

# Gateway is the ONLY host-exposed service in local V2 compose.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_HOST_PORT=8081

# Admin remains private (no host port mapping in compose).
# Keep bound to loopback/private interface by default.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
ADMIN_ENABLED=true
ADMIN_OIDC_ISSUER=https://issuer.example
ADMIN_OIDC_AUDIENCE=groceryclaw-admin
ADMIN_OIDC_JWKS_URI=http://127.0.0.1:18082/.well-known/jwks.json
ADMIN_OIDC_ROLES_CLAIM=roles
ADMIN_BREAKGLASS_ENABLED=false
ADMIN_BREAKGLASS_API_KEY=
ADMIN_BREAKGLASS_SCOPE=read_only
ADMIN_TENANT_ENDPOINTS_ENABLED=true
INVITE_PEPPER_B64=
ADMIN_INVITE_TTL_HOURS=72
ADMIN_INVITE_RATE_PER_TENANT_PER_MINUTE=10
ADMIN_SECRETS_ENABLED=true
# 32-byte key base64; keep local-only and never commit real keys.
ADMIN_MEK_B64=

# Worker has no host exposure.
WORKER_HOST=0.0.0.0
WORKER_PORT=3002
WORKER_HEALTH_PORT=3002
WORKER_HEALTH_SERVER_ENABLED=true

# Required DB credentials for local compose (set in your local .env only)
POSTGRES_DB=groceryclaw_v2
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
DB_APP_URL=postgresql://app_user:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}
DB_ADMIN_URL=postgresql://admin_reader:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}
DB_STATEMENT_TIMEOUT_MS=5000

# Required Redis password for local compose (set in your local .env only)
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

V2_GATEWAY_WEBHOOK_ENABLED=true

# Telegram (gateway + worker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# Webhook mode only: secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Optional Bot API root for the worker (default https://api.telegram.org)
TELEGRAM_API_BASE_URL=

# Webhook authenticity defaults
WEBHOOK_VERIFY_MODE=mode1
WEBHOOK_SIGNATURE_SECRET=
WEBHOOK_SIGNATURE_HEADERS=x-zalo-signature

# Mode 2 fallback controls
WEBHOOK_MODE2_TOKEN=
WEBHOOK_MODE2_TOKEN_HEADER=x-webhook-token
WEBHOOK_MODE2_ALLOW_IN_PRODUCTION=false
WEBHOOK_MODE2_GLOBAL_RATE_PER_MINUTE=300
WEBHOOK_MODE2_PER_IP_RATE_PER_MINUTE=60
WEBHOOK_MODE2_PER_PLATFORM_USER_RATE_PER_MINUTE=30
WEBHOOK_MODE2_ATTACHMENT_ALLOWLIST=zalo.me,zadn.vn

# Optional timestamp enforcement (only valid when WEBHOOK_VERIFY_MODE=mode1)
WEBHOOK_ENFORCE_TIMESTAMP=false
WEBHOOK_TIMESTAMP_HEADER=x-zalo-timestamp
WEBHOOK_TIMESTAMP_MAX_DRIFT_SECONDS=300

WEBHOOK_REPLAY_TTL_SECONDS=86400

V2_ONBOARDING_ENABLED=true
ONBOARDING_INVITE_USER_RATE_PER_MINUTE=10
ONBOARDING_INVITE_IP_RATE_PER_MINUTE=20
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9090
WORKER_CONCURRENCY=5
WORKER_XML_PARSE_ENABLED=true
WORKER_XML_ALLOWED_DOMAINS=zalo.me,zadn.vn
# Keep empty in production. Only set explicit internal stub domains in controlled test environments.
WORKER_XML_ALLOW_HTTP_DOMAINS=
WORKER_XML_MAX_BYTES=1048576
WORKER_XML_TIMEOUT_MS=10000
WORKER_MAPPING_ENABLED=true
WORKER_KIOTVIET_SYNC_ENABLED=true
KIOTVIET_SYNC_MAX_RETRIES=3
KIOTVIET_SYNC_BACKOFF_MS=200
KIOTVIET_TIMEOUT_MS=2000
KIOTVIET_STUB_BASE_URL=http://127.0.0.1:18080
KIOTVIET_STUB_TOKEN=
WORKER_MEK_B64=
WORKER_NOTIFIER_ENABLED=true
NOTIFIER_MAX_MESSAGE_LENGTH=500
NOTIFIER_RATE_LIMIT_ENABLED=true
NOTIFIER_GLOBAL_RATE_PER_MINUTE=120
NOTIFIER_TENANT_RATE_PER_MINUTE=30
NOTIFIER_USER_BURST=5
NOTIFIER_DLQ_ENABLED=true
NOTIFIER_MAX_ATTEMPTS=4
NOTIFIER_RETRY_BASE_MS=500
NOTIFIER_RETRY_MAX_MS=10000
WORKER_INTERACTION_WINDOW_ENFORCED=true
WORKER_INTERACTION_WINDOW_SECONDS=86400
WORKER_PENDING_TTL_SECONDS=604800
WORKER_MAX_PENDING_PER_USER=20
WORKER_FLUSH_PENDING_ENABLED=true
WORKER_FLUSH_BATCH_SIZE=20
WORKER_FLUSH_MAX_PER_RUN=50
WORKER_FLUSH_RATE_PER_MINUTE=60
ZALO_STUB_BASE_URL=http://127.0.0.1:18081
ZALO_STUB_TOKEN=
ZALO_STUB_TIMEOUT_MS=2000

BULLMQ_QUEUE_NAME=process-inbound

# --- OpenAI / AI Features ---
OPENAI_API_KEY=
WORKER_IMAGE_OCR_ENABLED=false
WORKER_CHATBOT_ENABLED=false
OPENAI_OCR_MODEL=gpt-4o
OPENAI_CHATBOT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
WORKER_IMAGE_MAX_BYTES=10485760
CHATBOT_MAX_CONTEXT_PRODUCTS=20

# ShopVoice MCP server (Alexa+ MCP). Host port is loopback-only by default.
MCP_HOST_PORT=127.0.0.1:8090
MCP_DATA_BACKEND=postgres
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_LOCALHOST_ORIGINS=true
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_CONFIRM_TTL_SECONDS=300
# Demo bearer token (>= 32 chars, local only). Leave empty to have `npm run db:v2:seed -- --demo` generate one.
MCP_DEMO_TOKEN=
DEMO_ANCHOR_DATE=

# ShopVoice simulator (apps/alexa-sim). rules = offline brain; bedrock = Amazon Bedrock Converse tool use.
SIM_HOST_PORT=127.0.0.1:8091
SIM_BRAIN=rules
# browser = Web Speech API voice; polly = Amazon Polly neural voice.
SIM_TTS=browser
# Optional passcode protecting /api/* when the simulator is public (Bedrock/Polly cost money).
SIM_ACCESS_CODE=
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
POLLY_VOICE_ID=Joanna
AWS_REGION=us-east-1
# AWS credentials for Bedrock/Polly (local only; on AWS use the task/instance role instead).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
