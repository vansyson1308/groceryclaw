# ============================================================
# GroceryClaw Production Environment
# Copy to .env.prod and fill all values. chmod 600 .env.prod
# ============================================================

# --- Telegram Bot ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- PostgreSQL (containerized) ---
POSTGRES_DB=groceryclaw_v2
# Generate passwords: openssl rand -base64 16
POSTGRES_SUPERUSER=groceryclaw_super
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_USER=groceryclaw_app
APP_DB_PASSWORD=

# --- Redis (containerized) ---
# Generate: openssl rand -base64 24
REDIS_PASSWORD=

# --- Encryption (admin + worker share same key) ---
# Generate: openssl rand -base64 32
MEK_B64=

# --- Invite Code Pepper ---
# Generate: openssl rand -base64 32
INVITE_PEPPER_B64=

# --- Ops Endpoints Auth Key ---
# Used for /ops/create-invite and /ops/link-kiotviet
# Generate: openssl rand -hex 32
OPS_KEY=

# --- Admin Breakglass API Key ---
# Used for admin API access without OIDC
# Generate: openssl rand -hex 32
ADMIN_BREAKGLASS_API_KEY=

# --- Optional Overrides ---
# LOG_LEVEL=info
# GATEWAY_HOST_PORT=8081
# BULLMQ_QUEUE_NAME=process-inbound
