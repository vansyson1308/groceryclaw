# Admin minimal env contract (example values only)

# --- Core runtime ---
NODE_ENV=production
LOG_LEVEL=info
ADMIN_HOST=0.0.0.0
ADMIN_PORT=3001

# --- Data + cache dependencies (required) ---
DB_ADMIN_URL=postgresql://admin_reader:<APP_DB_PASSWORD>@postgres.internal:5432/groceryclaw_v2
REDIS_URL=redis://:<REDIS_PASSWORD>@redis.internal:6379/0

# --- Readiness / operations ---
READYZ_STRICT=true
READYZ_TIMEOUT_MS=300
ADMIN_METRICS_HOST=0.0.0.0
ADMIN_METRICS_PORT=9101

# --- Admin auth (required) ---
ADMIN_ENABLED=true
ADMIN_OIDC_ISSUER=https://issuer.example
ADMIN_OIDC_AUDIENCE=groceryclaw-admin
ADMIN_OIDC_JWKS_URI=https://issuer.example/.well-known/jwks.json
ADMIN_OIDC_ROLES_CLAIM=roles

# Optional break-glass (disable by default)
ADMIN_BREAKGLASS_ENABLED=false
ADMIN_BREAKGLASS_API_KEY=
ADMIN_BREAKGLASS_SCOPE=read_only

# --- Feature controls ---
ADMIN_TENANT_ENDPOINTS_ENABLED=true
ADMIN_SECRETS_ENABLED=true
ADMIN_INVITE_TTL_HOURS=72
ADMIN_INVITE_RATE_PER_TENANT_PER_MINUTE=10

# --- Crypto materials ---
INVITE_PEPPER_B64=<BASE64_32_BYTE_SECRET>
ADMIN_MEK_B64=<BASE64_32_BYTE_SECRET>
