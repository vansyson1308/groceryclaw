# Gateway minimal env contract (example values only)

# --- Core runtime ---
NODE_ENV=production
LOG_LEVEL=info
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- Data + queue dependencies (required) ---
DB_APP_URL=postgresql://app_user:<APP_DB_PASSWORD>@postgres.internal:5432/groceryclaw_v2
REDIS_URL=redis://:<REDIS_PASSWORD>@redis.internal:6379/0
BULLMQ_QUEUE_NAME=process-inbound

# --- Readiness / operations ---
READYZ_STRICT=true
READYZ_TIMEOUT_MS=300
GATEWAY_METRICS_HOST=0.0.0.0
GATEWAY_METRICS_PORT=9100

# --- Webhook auth (required for public ingress) ---
V2_GATEWAY_WEBHOOK_ENABLED=true
WEBHOOK_VERIFY_MODE=mode1
WEBHOOK_SIGNATURE_SECRET=<REQUIRED_SECRET>
WEBHOOK_SIGNATURE_HEADERS=x-zalo-signature
WEBHOOK_REPLAY_TTL_SECONDS=86400

# Optional mode2/timestamp controls (enable only if used)
WEBHOOK_MODE2_ALLOW_IN_PRODUCTION=false
WEBHOOK_ENFORCE_TIMESTAMP=false
WEBHOOK_TIMESTAMP_MAX_DRIFT_SECONDS=300

# --- Onboarding / invite behavior ---
V2_ONBOARDING_ENABLED=true
INVITE_PEPPER_B64=<BASE64_32_BYTE_SECRET>
ONBOARDING_INVITE_USER_RATE_PER_MINUTE=10
ONBOARDING_INVITE_IP_RATE_PER_MINUTE=20
