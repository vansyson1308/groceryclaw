# Worker minimal env contract (example values only)

# --- Core runtime ---
NODE_ENV=production
LOG_LEVEL=info
WORKER_HOST=0.0.0.0
WORKER_PORT=3002
WORKER_HEALTH_PORT=3002
WORKER_HEALTH_SERVER_ENABLED=true

# --- Data + queue dependencies (required) ---
DB_APP_URL=postgresql://app_user:<APP_DB_PASSWORD>@postgres.internal:5432/groceryclaw_v2
REDIS_URL=redis://:<REDIS_PASSWORD>@redis.internal:6379/0
BULLMQ_QUEUE_NAME=process-inbound
WORKER_CONCURRENCY=5

# --- Readiness / operations ---
READYZ_STRICT=true
READYZ_TIMEOUT_MS=300
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9090

# --- Processing feature flags ---
WORKER_XML_PARSE_ENABLED=true
WORKER_XML_ALLOWED_DOMAINS=zalo.me,zadn.vn
WORKER_MAPPING_ENABLED=true
WORKER_KIOTVIET_SYNC_ENABLED=true
WORKER_NOTIFIER_ENABLED=true

# --- Adapter integration values ---
KIOTVIET_STUB_BASE_URL=https://kiotviet.example
KIOTVIET_STUB_TOKEN=<REQUIRED_TOKEN>
ZALO_STUB_BASE_URL=https://zalo.example
ZALO_STUB_TOKEN=<REQUIRED_TOKEN>

# --- Worker crypto ---
WORKER_MEK_B64=<BASE64_32_BYTE_SECRET>
